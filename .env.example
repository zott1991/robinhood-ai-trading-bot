# Required
OPENAI_API_KEY=

# Robinhood MCP
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN_PATH=.robinhood_mcp_tokens.json
ROBINHOOD_AGENTIC_ACCOUNT_NUMBER=

# Bot behavior
MODE=auto
AUTO_CONFIRM=true
LOG_LEVEL=INFO
RUN_INTERVAL_SECONDS=600

# Trading limits
TRADE_EXCEPTIONS=
WATCHLIST_NAMES=My First List
WATCHLIST_OVERVIEW_LIMIT=10
PORTFOLIO_LIMIT=10
MIN_SELLING_AMOUNT_USD=1.0
MAX_SELLING_AMOUNT_USD=10.0
MIN_BUYING_AMOUNT_USD=1.0
MAX_BUYING_AMOUNT_USD=10.0

# OpenAI
OPENAI_MODEL_NAME=gpt-4o-mini
